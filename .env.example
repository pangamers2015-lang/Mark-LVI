# Copie este arquivo para .env e preencha suas próprias chaves.
# Nunca envie .env ao GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RPM_LIMIT=40

# O Ion usa Gemini para planejar por padrão; NVIDIA é alternativa automática.
ION_PLANNER_PROVIDER=gemini
ION_WORKSPACE_ROOT=
ION_REQUEST_TIMEOUT=240
ION_MAX_CORRECTION_ATTEMPTS=2
ION_KNOWLEDGE_CONTEXT_CHARS=18000
ION_TEST_TIMEOUT_SECONDS=180
